# Tang Nano 9K ピン制約
# デバイス: GW1NR-LV9QN88PC6/I5

# クロック（27MHz オンボード水晶）
IO_LOC  "sys_clk" 52;
IO_PORT "sys_clk" PULL_MODE=UP;

# リセットボタン（S1）
# S1 は BANK0（1.8V）に接続されている
IO_LOC  "sys_rst_n" 3;
IO_PORT "sys_rst_n" PULL_MODE=UP IO_TYPE=LVCMOS18;

# オンボード LED x6（active low: Low で点灯）
IO_LOC  "led[0]" 10;
IO_LOC  "led[1]" 11;
IO_LOC  "led[2]" 13;
IO_LOC  "led[3]" 14;
IO_LOC  "led[4]" 15;
IO_LOC  "led[5]" 16;
